; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text.

[application]

config/name="Island Idle"
config/description="Arcade Idle game - gather resources, sell, expand your island!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameData="*res://scripts/game_data.gd"
LocationManager="*res://scripts/location_manager.gd"
YandexSDK="*res://scripts/yandex_sdk.gd"
Achievements="*res://scripts/achievements.gd"
SaveManager="*res://scripts/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

